# Copy to .env. Keep .env private. run.ps1 loads it automatically.
MONGODB_URI=
APP_ORIGIN=http://localhost:8080
PORT=8080
SERVER_ADDRESS=127.0.0.1
SECURE_COOKIE=false
# Optional first administrator. Set your own email and a strong password.
# Remove ADMIN_PASSWORD after the first successful startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
